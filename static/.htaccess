# Generated by scripts/generate-htaccess.js from src/data/districts.json - do not edit by hand.
# See docs/DISTRICTS.md.

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Dhaka: dhaka.rajdoctors.com -> rajdoctors.com/dhaka/
RewriteCond %{HTTP_HOST} ^(?:www\.)?dhaka\.rajdoctors\.com$ [NC]
RewriteRule ^((?:en|bn)/)?$ https://rajdoctors.com/$1dhaka/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?dhaka\.rajdoctors\.com$ [NC]
RewriteRule ^((?:en|bn)/)?(doctor|doctors|speciality|emergency)(/.*)?$ https://rajdoctors.com/$1dhaka/$2$3 [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?dhaka\.rajdoctors\.com$ [NC]
RewriteRule ^(.*)$ https://rajdoctors.com/$1 [R=301,L]

# Sylhet: sylhet.rajdoctors.com -> rajdoctors.com/sylhet/
RewriteCond %{HTTP_HOST} ^(?:www\.)?sylhet\.rajdoctors\.com$ [NC]
RewriteRule ^((?:en|bn)/)?$ https://rajdoctors.com/$1sylhet/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?sylhet\.rajdoctors\.com$ [NC]
RewriteRule ^((?:en|bn)/)?(doctor|doctors|speciality|emergency)(/.*)?$ https://rajdoctors.com/$1sylhet/$2$3 [R=301,L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?sylhet\.rajdoctors\.com$ [NC]
RewriteRule ^(.*)$ https://rajdoctors.com/$1 [R=301,L]

# Rajshahi used to be the root of rajdoctors.com: /doctor/x -> /rajshahi/doctor/x
RewriteRule ^((?:en|bn)/)?(doctor|doctors|speciality|emergency)(/.*)?$ /$1rajshahi/$2$3 [R=301,L]

</IfModule>
